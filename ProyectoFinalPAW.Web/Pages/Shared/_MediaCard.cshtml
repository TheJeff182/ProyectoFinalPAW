@using ProyectoFinalPAW.Core.Export
@model ExportItem

@* Se muestra una tarjeta reutilizable para cualquier item del estándar. *@
<div class="card h-100 shadow-sm">
    @* La miniatura es mostrada solo si existe. *@
    @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
    {
        <img src="@Model.Thumbnail" class="card-img-top" alt="@Model.Title" loading="lazy"
             style="height: 200px; object-fit: cover;" />
    }

    <div class="card-body">
        @* Se muestran el tipo de medio y la categoría como etiquetas. *@
        <span class="badge bg-primary">@Model.MediaType</span>
        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
            <span class="badge bg-secondary">@Model.Category</span>
        }

        <h5 class="card-title mt-2">@Model.Title</h5>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="card-text small">@Model.Description</p>
        }
    </div>

    @* Se muestran la fecha y el enlace al contenido original. *@
    <div class="card-footer d-flex justify-content-between align-items-center">
        <small class="text-muted">@Model.CreatedAt.ToString("yyyy-MM-dd")</small>
        @if (!string.IsNullOrWhiteSpace(Model.Url))
        {
            <a href="@Model.Url" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Ver</a>
        }
    </div>
</div>
